# --- SynkAfrica frontend (Next.js) environment ---
# Copy to .env and fill in. Values marked (required) are needed for the app to
# run; the rest enable optional features.

# Base URL of the NestJS backend, including the /api prefix. (required)
NEXT_PUBLIC_API_URL=http://localhost:4001/api

# next-auth v5 session-encryption secret. (required)
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Canonical URL of THIS frontend. (optional)
# Sign-in/sign-out redirects no longer depend on it — those use relative paths
# resolved against whatever origin the user is on. Set it only if you need
# Auth.js to build absolute URLs against a fixed origin (e.g. a stable OAuth
# callback URL for Google/Apple).
# AUTH_URL=https://app.synkafrica.com

# --- Social sign-in (optional) ---
# Google sign-in stays hidden/non-functional until BOTH are set.
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# Apple sign-in stays non-functional until BOTH are set. AUTH_APPLE_SECRET is
# the signed client-secret JWT generated from your Apple private key / key id /
# team id / service id (see Apple "Sign in with Apple" setup).
# AUTH_APPLE_ID=
# AUTH_APPLE_SECRET=

# NOTE: social sign-in also needs a backend bridge that exchanges the OAuth
# identity for a backend session (access/refresh tokens). The Credentials
# (OTP / vendor / admin) flows produce those today; a Google/Apple identity
# does not yet. Wiring that bridge is a follow-up beyond supplying credentials.
